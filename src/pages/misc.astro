---
import Container from '@/components/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Misc" description="Other notes and small things.">
  <Container>
    <h1 class="page-title">Misc</h1>
    <p class="text-muted-foreground mt-4 max-w-prose leading-relaxed">
      A place for small things that don’t fit the writing archive yet. There’s
      nothing here at the moment; the <a class="text-foreground" href="/blog/">writing archive</a>
      has the current posts.
    </p>
  </Container>
</BaseLayout>
