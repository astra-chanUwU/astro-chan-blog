---
import Container from '@/components/Container.astro';
import DiscoveryBar from '@/components/DiscoveryBar.astro';
import PostCard from '@/components/PostCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllTags, getSortedPosts } from '@/lib/posts';

const posts = await getSortedPosts();
const tags = getAllTags(posts);
---

<BaseLayout title="Writing" description="Notes, projects, and things I’m learning.">
  <Container>
    <header class="page-intro">
      <h1 class="page-title">Writing</h1>
      <p class="page-description">Notes on software, things I’m building, and what I learn along the way.</p>
    </header>
    <DiscoveryBar tags={tags} />
    <div class="mt-4">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
    {posts.length === 0 && (
      <p class="text-muted-foreground py-6 text-sm">No posts yet.</p>
    )}
  </Container>
</BaseLayout>
