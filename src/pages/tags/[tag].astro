---
import { getSitePath } from '@/lib/posts';
import DiscoveryBar from '@/components/DiscoveryBar.astro';
import Container from '@/components/Container.astro';
import PostCard from '@/components/PostCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllTags, getSortedPosts, type Post } from '@/lib/posts';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const tags = getAllTags(posts);
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
const tags = getAllTags(await getSortedPosts());
---

<BaseLayout title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  <Container>
    <p class="text-muted-foreground mb-3 font-sans text-sm"><a href={getSitePath("/tags/")}>← Topics</a></p>
    <h1 class="page-title">{tag}</h1>
    <p class="text-muted-foreground mt-2 font-sans text-sm">
      {posts.length} post{posts.length === 1 ? '' : 's'}
    </p>
    <DiscoveryBar tags={tags} activeTag={tag} />
    <div class="mt-4">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
    <a href={getSitePath("/blog/")} class="text-muted-foreground hover:text-foreground mt-8 inline-block font-sans text-sm">
      ← all writing
    </a>
  </Container>
</BaseLayout>
