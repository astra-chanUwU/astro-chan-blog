---
import Container from '@/components/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllTags, getSortedPosts, getTagUrl } from '@/lib/posts';

const posts = await getSortedPosts();
const tags = getAllTags(posts);
---

<BaseLayout title="Tags" description="Browse writing by tag.">
  <Container>
    <h1 class="page-title">Topics</h1>
    <p class="page-description">A few ways into the archive.</p>
    {tags.length > 0 ? (
      <ul class="tag-directory">
        {tags.map((tag) => {
          const count = posts.filter((post) => post.data.tags.includes(tag)).length;
          return (
            <li>
              <a href={getTagUrl(tag)}><span>{tag}</span><span class="tag-count">{count} post{count === 1 ? '' : 's'}</span></a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="text-muted-foreground mt-5 text-sm">No tags yet.</p>
    )}
  </Container>
</BaseLayout>
