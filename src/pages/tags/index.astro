---
import Container from '@/components/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllTags, getSortedPosts, getTagUrl } from '@/lib/posts';

const posts = await getSortedPosts();
const tags = getAllTags(posts);
---

<BaseLayout title="Tags" description="Browse writing by tag.">
  <Container>
    <h1 class="page-title">tags</h1>
    {tags.length > 0 ? (
      <ul class="mt-6 space-y-3">
        {tags.map((tag) => {
          const count = posts.filter((post) => post.data.tags.includes(tag)).length;
          return (
            <li class="flex items-baseline gap-3">
              <a href={getTagUrl(tag)} class="font-sans text-foreground">#{tag}</a>
              <span class="text-muted-foreground text-sm">{count} post{count === 1 ? '' : 's'}</span>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="text-muted-foreground mt-5 text-sm">No tags yet.</p>
    )}
  </Container>
</BaseLayout>
