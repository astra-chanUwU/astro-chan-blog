---
import { getTagUrl } from '@/lib/posts';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="mb-7 space-y-4">
  <form action="/search/" method="get" role="search" class="flex max-w-xl items-center gap-2">
    <label class="sr-only" for="blog-search">Search writing</label>
    <input
      id="blog-search"
      name="q"
      type="search"
      placeholder="Search writing"
      class="text-foreground placeholder:text-muted-foreground min-w-0 flex-1 rounded-md border-0 bg-[var(--reader-control)] px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
    />
    <button class="text-muted-foreground hover:text-foreground px-1 py-2 text-sm" type="submit">
      Search
    </button>
  </form>
  {tags.length > 0 && (
    <nav aria-label="Browse writing by tag" class="flex flex-wrap gap-x-4 gap-y-1 font-sans text-sm">
      {tags.map((tag) => (
        <a href={getTagUrl(tag)} class="text-muted-foreground hover:text-foreground">#{tag}</a>
      ))}
      <a href="/tags/" class="text-muted-foreground hover:text-foreground">All tags</a>
    </nav>
  )}
</div>
