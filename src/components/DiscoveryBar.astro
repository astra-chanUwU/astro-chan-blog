---
import SearchField from '@/components/SearchField.astro';
import TagLinks from '@/components/TagLinks.astro';
interface Props { tags: string[]; activeTag?: string; }
const { tags, activeTag } = Astro.props;
---

<div class="discovery-bar">
  <form action="/search/" method="get" role="search">
    <SearchField id="blog-search" />
    {activeTag && <input type="hidden" name="tag" value={activeTag} />}
  </form>
  <TagLinks tags={tags} activeTag={activeTag} />
</div>
