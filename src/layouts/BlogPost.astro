---
import { getTagUrl, type Post } from '@/lib/posts';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, draft } = post.data;
const formatDate = (date: Date) => date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  title={title}
  description={description}
  article={{ publishedTime: pubDate.toISOString(), modifiedTime: updatedDate?.toISOString() }}
  noindex={draft}
>
  <article class="post-article" data-pagefind-body data-pagefind-filter="type:post">
    <header class="post-header">
      <div class="post-meta">
        <time datetime={pubDate.toISOString()} data-pagefind-meta="date[datetime]">
          {formatDate(pubDate)}
        </time>
        {updatedDate && <span>Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>}
      </div>
      <h1 class="post-title" data-pagefind-meta="title">{title}</h1>
      <p class="post-description" data-pagefind-meta="description">{description}</p>
      {draft && <p class="text-muted-foreground text-sm" data-pagefind-ignore>Draft preview</p>}
      {tags.length > 0 && (
        <nav class="post-tags" aria-label="Post tags">
          {tags.map((tag) => <a href={getTagUrl(tag)} data-pagefind-filter="tag">{tag}</a>)}
        </nav>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
    <a href="/blog/" class="back-to-writing" data-pagefind-ignore>← All writing</a>
  </article>
</BaseLayout>

<script>
  import { initializeCodeBlocks } from '@/scripts/code-blocks';
  initializeCodeBlocks();
</script>
