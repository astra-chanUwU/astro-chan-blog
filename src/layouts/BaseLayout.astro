---
import { ClientRouter, fade } from 'astro:transitions';
import { getSitePath } from '@/lib/posts';
import { ThemeInitScript } from '@starwind-ui/astro/theme';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import '@/styles/starwind.css';

interface Props {
  title?: string;
  description?: string;
  article?: { publishedTime: string; modifiedTime?: string };
  noindex?: boolean;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  article,
  noindex = false,
} = Astro.props;
const pageTitle = title === SITE_TITLE ? title : `${title} — ${SITE_TITLE}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(getSitePath('/images/social-card.png'), Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': article ? 'BlogPosting' : 'WebPage',
  name: pageTitle,
  ...(article ? { headline: title, datePublished: article.publishedTime, dateModified: article.modifiedTime ?? article.publishedTime } : {}),
  description,
  url: canonical.href,
  image: socialImage.href,
  author: { '@type': 'Person', name: SITE_AUTHOR, url: new URL(getSitePath('/'), Astro.site).href },
  isPartOf: { '@type': 'WebSite', name: SITE_TITLE, url: new URL(getSitePath('/'), Astro.site).href },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={getSitePath("/favicon.svg")} />
    <link rel="icon" type="image/png" sizes="32x32" href={getSitePath("/favicon-32.png")} />
    <link rel="apple-touch-icon" href={getSitePath("/apple-touch-icon.png")} />
    <link rel="preload" href={getSitePath("/fonts/atkinson-hyperlegible-regular.woff2")} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_AUTHOR} />
    <meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161719" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="astro-chan — notes on software and systems" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    {article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    <link rel="sitemap" href={getSitePath("/sitemap-index.xml")} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={getSitePath("/rss.xml")} />
    <ThemeInitScript />
    <ClientRouter />
  </head>
  <body class="bg-background text-foreground min-h-screen font-sans antialiased">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="reader-shell">
      <Header />
      <main id="main-content" class="reader-main" transition:name="content" transition:animate={fade({ duration: '160ms' })}><slot /></main>
      <Footer />
    </div>
  </body>
</html>
